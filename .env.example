# [Module: project.environment] [Status: 已完成] [Brief: 桌面与核心服务支持的可选环境变量]
# 应用读取进程环境变量；此文件是模板，不会自动加载。
# 模型、词库与解释器使用绝对路径；留空时请不设置对应变量。
MPLT_MODEL_PATH=
MPLT_RUNTIME_PYTHON=
MPLT_GLOSSARY_PATH=

# 桌面端初始任务根目录与 CFPA 缓存根目录。
# 保存桌面设置后优先使用已保存值，可在“模型与设置”中修改。
MPLT_DATA_DIR=
MPLT_CACHE_DIR=

# API 接口可在“密钥环境变量”栏指定这些名称；按所用服务设置其中一个。
# 此模板不会自动加载；填写环境变量后需在带该变量的进程中启动应用。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
